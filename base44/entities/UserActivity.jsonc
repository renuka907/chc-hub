{
  "name": "UserActivity",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user performing the action"
    },
    "user_full_name": {
      "type": "string",
      "description": "Full name of the user"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "view",
        "create",
        "edit",
        "delete",
        "export",
        "login"
      ],
      "description": "Type of action performed"
    },
    "page_name": {
      "type": "string",
      "description": "Page or section accessed"
    },
    "entity_type": {
      "type": "string",
      "description": "Type of entity affected (e.g., Procedure, Pricing, Inventory)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity affected"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the action occurred"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of the user"
    },
    "details": {
      "type": "string",
      "description": "Additional details about the action as JSON string"
    }
  },
  "required": [
    "user_email",
    "action_type",
    "page_name",
    "timestamp"
  ]
}