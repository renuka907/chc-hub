{
  "name": "Special",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title or name of the special"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the uploaded PDF or JPG file"
    },
    "date_from": {
      "type": "string",
      "format": "date",
      "description": "Start date of the special"
    },
    "date_to": {
      "type": "string",
      "format": "date",
      "description": "End date of the special"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether the special is archived"
    }
  },
  "required": [
    "file_url",
    "date_from",
    "date_to"
  ]
}